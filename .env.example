# ── Aether Archive — local environment ────────────────────────────────────────
# Copy this file to `.env` and adjust. NEVER commit the real `.env`.

# Where Aether Archive stores images and thumbnails.
# Absolute path, created automatically on first run; the backend falls back to
# ~/AetherArchive_Data when this is unset, which is why it is commented out: only
# uncomment it to put the archive somewhere else. (The database lives in its own
# Docker volume — see the PostgreSQL section below.)
# AETHER_DATA_DIR=/absolute/path/AetherArchive_Data

# ── PostgreSQL — local dev container (docker-compose.dev.yml, ADR-009) ────────
# `docker compose -f docker-compose.dev.yml up -d` reads this file from the repository
# root, and the backend imports it as well (`spring.config.import` in application.yml),
# so the same keys configure both sides — mechanism and caveats: backend/README.md.
# The values below are also the fallbacks the compose file uses when `.env` (or a
# single key) is absent, so a fresh clone starts without editing anything.
# Host port the database container publishes — bound to 127.0.0.1, never the LAN.
# If something already listens on 5432 (a system PostgreSQL, for example), set
# AETHER_DB_PORT=5433 here: the backend imports this file too, so its environment
# needs no matching variable.
AETHER_DB_PORT=5432
# Database name and credentials.
# IMPORTANT: these are consumed when the container initialises the volume the FIRST
# time. Changing them later does not touch an existing database — the backend would
# then fail to authenticate. Rename the role/database inside `psql` instead of
# reaching for `down -v`, which deletes the archive.
# This password is a placeholder, not a secret: it is committed on purpose. Put a real
# one in `.env` (gitignored) before the database is reachable by anything but this
# machine — and remember the first-initialisation caveat above.
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me-local
# Optional: full JDBC override (defaults are built from the values above, including
# AETHER_DB_PORT).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aether

# Backend HTTP port. When testing from a phone, browse to http://<LAN-IP>:<port>
SERVER_PORT=8080

# Spring profile. Leave unset for development: `application.yml` defaults to `dev`.
# The v1.0 container sets `prod` explicitly (E6-S11/S12, ADR-010) — never rely on the default there.
# SPRING_PROFILES_ACTIVE=prod

# Maximum size accepted per uploaded image (MB). Enforced backend-side.
AETHER_MAX_UPLOAD_MB=15

# Frontend → API base URL — an absolute *origin*, no `/api/v1` suffix: the client adds the prefix
# itself, and a suffix here doubles it (measured: 404, E2-S2). Leave it unset (the default): the Vite
# dev server proxies `/api/v1` and `/images` to the backend, and nginx does the same in the container,
# so a phone needs no per-device value. Set an absolute origin only for a build that talks to an API
# on another origin — and add that origin to AETHER_CORS_ALLOWED_ORIGINS below.
# Vite reads this file too (`envDir` in frontend/vite.config.ts points here), so a value set in it
# reaches the served app — E2-S2's review probe measured both sides of that; before the wiring, the
# key was silently ignored.
# VITE_API_BASE_URL=http://192.168.1.20:8080

# Dev-server only: the origin the Vite proxy forwards `/api/v1` and `/images` to. Defaults to
# http://localhost:8080; set it (here or in the shell) when the backend runs on another port.
# VITE_API_PROXY_TARGET=http://localhost:8099

# Dev-only: origins allowed to call the API (comma separated origin *patterns*).
# Wildcards inside the host are allowed (http://192.168.*.*:5173); a bare '*' — and a
# host that is only a wildcard, like https://* — is rejected at boot, because it would
# match every origin. An empty value disables cross-origin access entirely; a stray
# comma is a configuration error, not an empty value.
AETHER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.*.*:5173
