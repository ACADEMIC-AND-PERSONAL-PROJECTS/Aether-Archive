# ── Aether Archive — local environment ────────────────────────────────────────
# Copy this file to `.env` and adjust. NEVER commit the real `.env`.

# Where Aether Archive stores images and thumbnails.
# Absolute path. Created automatically on first run. (The database lives in its own
# Docker volume — see the PostgreSQL section below.)
AETHER_DATA_DIR=/home/CHANGE_ME/AetherArchive_Data

# ── PostgreSQL — local dev container (docker-compose.dev.yml, ADR-009) ────────
# Host port the database container publishes.
AETHER_DB_PORT=5432
# Database name and credentials — used by the container and by Spring Boot.
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me-local
# Optional: full JDBC override (defaults are built from the values above).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aether

# Backend HTTP port. When testing from a phone, browse to http://<LAN-IP>:<port>
SERVER_PORT=8080

# Maximum size accepted per uploaded image (MB). Enforced backend-side.
AETHER_MAX_UPLOAD_MB=15

# Frontend → API base URL. Use http://localhost:8080/api/v1 on the PC,
# or http://<LAN-IP>:8080/api/v1 when opening the Vite dev server from a phone.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Dev-only: origins allowed to call the API (comma separated, wildcards allowed).
AETHER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.*.*:5173
