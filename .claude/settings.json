    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push -u origin main*)",
      "Bash(git push -u origin develop*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D develop*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push origin --delete develop*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge * --rebase*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /home/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)"
    ]
