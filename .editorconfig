root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

# Windows batch files (the Maven wrapper's mvnw.cmd) require CRLF to run at all —
# the repository-wide `end_of_line = lf` above must not be applied to them.
[*.{cmd,bat}]
end_of_line = crlf

[*.{md,mdx}]
trim_trailing_whitespace = false
