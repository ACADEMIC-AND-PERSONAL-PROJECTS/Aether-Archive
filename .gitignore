# ── OS / editors ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
.metals/
.bloop/

# ── Secrets & personal agent config ───────────────────────────────────────────
.env
.env.*
!.env.example
CLAUDE.local.md
.claude/settings.local.json
.claude/tmp/

# ── Local data (images, database dumps) — never committed ─────────────────────
AetherArchive_Data/
data/

# ── Java / Maven ──────────────────────────────────────────────────────────────
backend/target/
*.class
*.log
hs_err_pid*
.mvn/timing.properties

# ── Node / Vite ───────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# ── Coverage / generated ──────────────────────────────────────────────────────
**/coverage/
**/.pytest_cache/
reports/*.tmp
# Committed evidence logs referenced by a report (the live copies stay gitignored).
!reports/evidence/*.log

# ── On-call runtime ───────────────────────────────────────────────────────────
oncall/webhook-token
oncall/incidents/*.json
!oncall/incidents/.gitkeep
oncall/state/*
!oncall/state/.gitkeep
state/*
!state/.gitkeep
__pycache__/
*.pyc

# ── Deploy runtime ────────────────────────────────────────────────────────────
backups/
